# ==============================================================================
# PhytoAgent - Server Environment Configuration Example
# Copy this file to .env and configure your values:
#   cp .env.example .env
# ==============================================================================

# Application Settings
PROJECT_NAME="PhytoAgent"
VERSION="0.1.0"
DEBUG=true
API_V1_STR="/api/v1"

# CORS Configuration (JSON array or comma-separated list of origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database URL Configuration
# 1) For PostgreSQL (Recommended for production & full feature set):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/plant_agent"

# 2) For Async SQLite (Quick local development / testing without PostgreSQL server):
# DATABASE_URL="sqlite+aiosqlite:///./plant_agent.db"

# LLM & OpenAI Configuration (Optional for knowledge-base & rule-based engine, required for LLM chat agent)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL_NAME="gpt-4o"
